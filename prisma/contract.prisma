// use prisma-8

// Ported by hand from prisma/schema.prisma (Prisma ORM 7). Table names are kept
// via @@map so the storage layout is unchanged.

model Participant {
  id               String   @id @default(cuid(2))
  createdAt        temporal.createdAt()
  updatedAt        temporal.updatedAt()

  email            String   @unique
  // sha256 of the code shown once at registration; lets a participant edit their
  // existing response. Nullable: existing rows registered before this feature
  // shipped have none yet (an admin can issue one via "regenerate code"), but
  // every new registration always gets one. Nullable + unique is fine in
  // Postgres — multiple NULLs don't violate a unique constraint.
  editCodeHash     String?  @unique
  twtUser          String
  yumeshipName     String
  oshiName         String
  relationshipType String
  fandomYume       String
  contentType      String
  languageReceive  String
  fandomGive       String
  yumeTypeGive     String
  yumeDocuLink     String
  yumeTypeReceive  String?
  languageGive     String?
  notes            String?
  folderLink       String?
  // Email that currently has editor access to folderLink (the giver of this
  // participant at the time it was shared). Lets the admin page spot a folder
  // still shared with an old giver after a reshuffle, and revoke it on re-share.
  folderSharedWith String?
  avoidList        String?

  givingMatches    Match[]  @relation("giver")
  receivingMatches Match[]  @relation("receiver")

  @@map("Participant")
}

model MatchRun {
  id                String   @id @default(cuid(2))
  createdAt         temporal.createdAt()
  seed              Int?
  totalParticipants Int
  matchedPairs      Int
  matches           Match[]
  reshuffleLogs     MatchReshuffleLog[]
  removals          MatchRunRemoval[]

  // Manually set by an admin to close /confirm/[token] links (no more
  // confirms or reports accepted). Null means still open. Two rounds:
  // #1 covers pairs untouched since the original matching, #2 covers pairs
  // (re)assigned later by a reshuffle, force-match or restore — so round #1
  // can close on time while reshuffled pairs still get to confirm. See
  // lib/confirmRound.ts for how a pair's round is decided.
  confirmationClosedAt  DateTime?
  confirmation2ClosedAt DateTime?

  // Marks the one run admins are currently working from, since several runs
  // accumulate over time (reshuffle testing, re-runs). At most one run has
  // this set at a time — enforced in the API, not the schema.
  isActive Boolean @default(false)

  @@map("MatchRun")
}

model Match {
  id         String      @id @default(cuid(2))
  matchRunId String
  matchRun   MatchRun    @relation(fields: [matchRunId], references: [id], onDelete: Cascade)
  giverId    String
  giver      Participant @relation("giver", fields: [giverId], references: [id])
  receiverId String
  receiver   Participant @relation("receiver", fields: [receiverId], references: [id])
  // Set once the giver has been emailed who they're matched with (fandom,
  // oshi, avoid list, etc). Lets admins resend in batches (Gmail caps sends
  // per day) without double-emailing everyone already notified.
  notifiedAt       DateTime?
  // Set once the giver has been emailed the receiver's Drive upload folder
  // link. Sent separately from the match-info email, since the folder is
  // usually created and linked some time after matching happens.
  folderNotifiedAt DateTime?

  // Unguessable token embedded in the match-info email's confirm/report
  // link (/confirm/[token]) — generated lazily the first time that email is
  // sent, so the public confirm page needs no participant login.
  confirmToken     String?   @unique
  // Set when the giver confirms the match looks correct.
  confirmedAt      DateTime?
  // Set when the giver instead reports a problem (double booking, wrong
  // fandom, etc) via the same page, with their note kept for admins.
  reportedAt       DateTime?
  reportNote       String?

  // Set when the giver ticks the disclaimer box on /submit/[token] after
  // uploading their gift to the receiver's Drive folder. No file handling
  // on our side — the gift itself stays in Drive, this just records the
  // giver's self-attestation that it meets the minimum criteria.
  submittedAt      DateTime?

  // Self-service extension via /extend/[token] — auto-approved up to 3 days,
  // just logged here so admins can see who extended without being texted.
  extensionDays        Int?
  extensionRequestedAt DateTime?
  extensionReason      String?

  @@unique([matchRunId, giverId])
  @@map("Match")
}

// One row per giver per reshuffle apply, recording what their pairing was
// right before it changed. A frozen snapshot (not FKs to Participant) on
// purpose: history should show what the pairing said back then, not get
// silently rewritten by a later edit to that participant's data.
model MatchReshuffleLog {
  id           String   @id @default(cuid(2))
  matchRunId   String
  matchRun     MatchRun @relation(fields: [matchRunId], references: [id], onDelete: Cascade)
  reshuffledAt temporal.createdAt()
  // Null for an auto-resolved chain (findMinimalBreakChain is deterministic,
  // not randomized), set for a manual seeded reshuffle.
  seed         Int?

  giverTwt                   String
  previousReceiverTwt        String
  previousReceiverOshiName   String
  previousReceiverFandomYume String
  newReceiverTwt             String
  newReceiverOshiName        String
  newReceiverFandomYume      String

  @@map("MatchReshuffleLog")
}

// A participant an admin pulled out of a run (e.g. never confirmed in time),
// kept so they can be put back later. Their former partners are remembered
// so a restore can recreate those pairs if the slots are still free. Plain
// ids rather than FKs to Participant, like RejectedPair.
model MatchRunRemoval {
  id               String   @id @default(cuid(2))
  matchRunId       String
  matchRun         MatchRun @relation(fields: [matchRunId], references: [id], onDelete: Cascade)
  removedAt        temporal.createdAt()
  participantId    String
  formerReceiverId String?
  formerGiverId    String?

  @@unique([matchRunId, participantId])
  @@map("MatchRunRemoval")
}

// Every giver → receiver pairing that was ever reported, in any run. A report
// lives on the Match row itself (reportedAt), but a reshuffle clears it when
// it moves the giver to someone new — without this table the next reshuffle
// (or a fresh run) has no memory of the rejection and can pair them right
// back together. Plain ids rather than FKs, on purpose: deleting a run must
// not take its rejections with it, and a participant edit shouldn't either.
model RejectedPair {
  id         String   @id @default(cuid(2))
  createdAt  temporal.createdAt()
  // The run the report was made in — kept for history only.
  matchRunId String
  giverId    String
  receiverId String
  note       String?

  @@unique([matchRunId, giverId, receiverId])
  @@map("RejectedPair")
}

// Admin-editable overrides for the public registration form's own wording
// (field labels, hints, rules text, option labels). A missing row means
// "use the hardcoded default" (see lib/formCopy.ts) — this table only ever
// holds the strings an admin has actually changed.
model FormCopy {
  key       String   @id
  value     String
  updatedAt temporal.updatedAt()

  @@map("FormCopy")
}
